{
  "name": "dictation-turbo",
  "version": "0.2.0",
  "description": "双击 Control 说话，文字落进 DSH 输入框；中文/德语/英文自动换引擎，不用切输入法",
  "author": "Jie Da",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dictation",
    "speech-to-text",
    "voice-input",
    "hotkey",
    "multilingual",
    "german",
    "accessibility"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
